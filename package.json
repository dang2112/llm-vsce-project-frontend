{
  "name": "llm-vsce-project-frontend",
  "displayName": "llm-vsce-project-frontend",
  "description": "frontend for a vsc extension for a python llm debugger",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.138.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
        "activitybar": [
            {
                "id": "pythonDebugAgent",
                "title": "Python Debug Agent",
                "icon": "media/icon.svg"
            }
        ]
    },

    "views": {
        "pythonDebugAgent": [
            {
                "type": "webview",
                "id": "pythonDebugAgent.debugView",
                "name": "Debugger",
                "icon": "media/icon.svg"
            }
        ]
    }
},
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.138.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
